<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - SnapShop Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-lg">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-xl font-bold text-gray-800">SnapShop Admin</h2>
            </div>
            
            <nav class="mt-6">
                <div class="px-4 space-y-2">
                    <a href="/dashboard" class="flex items-center px-4 py-2 rounded-lg transition-colors <%= currentPage === 'dashboard' ? 'text-blue-700 bg-blue-50 border-l-4 border-blue-500' : 'text-gray-600 hover:bg-gray-50' %>">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5v14"></path>
                        </svg>
                        Dashboard
                    </a>
                    
                    <a href="/dashboard/products" class="flex items-center px-4 py-2 rounded-lg transition-colors <%= currentPage === 'products' ? 'text-blue-700 bg-blue-50 border-l-4 border-blue-500' : 'text-gray-600 hover:bg-gray-50' %>">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                        Products
                    </a>
                    
                    <a href="/dashboard/users" class="flex items-center px-4 py-2 rounded-lg transition-colors <%= currentPage === 'users' ? 'text-blue-700 bg-blue-50 border-l-4 border-blue-500' : 'text-gray-600 hover:bg-gray-50' %>">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                        </svg>
                        Users
                    </a>
                    
                    <a href="/dashboard/orders" class="flex items-center px-4 py-2 rounded-lg transition-colors <%= currentPage === 'orders' ? 'text-blue-700 bg-blue-50 border-l-4 border-blue-500' : 'text-gray-600 hover:bg-gray-50' %>">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                        Orders
                    </a>
                </div>
            </nav>
            
            <div class="absolute bottom-0 w-64 p-4 border-t border-gray-200">
                <a href="/logout" class="flex items-center px-4 py-2 text-red-600 hover:bg-red-50 rounded-lg">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                    Logout
                </a>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="flex-1 overflow-auto">
            <%- body %>
        </div>
    </div>
</body>
</html>
