<div class="p-8">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Manage Products</h1>
            <p class="text-gray-600">View and manage all products - Total Products: <%= products ? products.length : 0 %></p>
        </div>
        <a 
            href="/dashboard/add-product"
            class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
        >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add Product
        </a>
    </div>
    
    <% if (products && products.length > 0) { %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">All Products (<%= products.length %>)</h3>
            </div>
            
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Image & Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category & Description</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price & Stock</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sizes & Colors</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Gender & Discount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% products.forEach(product => { %>
                            <tr class="hover:bg-gray-50">
                                <!-- Image & Name Column -->
                                <td class="px-6 py-4">
                                    <div class="flex items-center space-x-3">
                                        <div class="flex-shrink-0">
                                            <% if (product.image) { %>
                                                <img src="<%= product.image %>" alt="<%= product.name %>" class="w-16 h-16 object-cover rounded-lg border">
                                            <% } else { %>
                                                <div class="w-16 h-16 bg-gray-200 rounded-lg flex items-center justify-center">
                                                    <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                    </svg>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div>
                                            <div class="text-sm font-medium text-gray-900">
                                                <%= product.name || 'N/A' %>
                                            </div>
                                            <div class="text-xs text-gray-500">
                                                ID: <%= product._id.toString().slice(-8) %>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                
                                <!-- Category & Description Column -->
                                <td class="px-6 py-4">
                                    <div class="space-y-1">
                                        <div class="text-sm font-medium text-gray-900">
                                            <%= product.category || 'N/A' %>
                                        </div>
                                        <div class="text-xs text-gray-600 max-w-xs truncate">
                                            <%= product.description || 'No description' %>
                                        </div>
                                    </div>
                                </td>
                                
                                <!-- Price & Stock Column -->
                                <td class="px-6 py-4">
                                    <div class="space-y-1">
                                        <div class="text-lg font-bold text-blue-600">
                                            ₹<%= product.price || 0 %>
                                        </div>
                                        <div class="text-sm text-gray-900">
                                            Stock: <span class="font-medium"><%= product.stock || 0 %></span>
                                        </div>
                                    </div>
                                </td>
                                
                                <!-- Sizes & Colors Column -->
                                <td class="px-6 py-4">
                                    <div class="space-y-1">
                                        <div class="text-xs text-gray-900">
                                            <span class="font-medium">Sizes:</span>
                                            <% if (product.sizes && product.sizes.length > 0) { %>
                                                <%= product.sizes.join(', ') %>
                                            <% } else { %>
                                                N/A
                                            <% } %>
                                        </div>
                                        <div class="text-xs text-gray-900">
                                            <span class="font-medium">Colors:</span>
                                            <% if (product.colors && product.colors.length > 0) { %>
                                                <%= product.colors.join(', ') %>
                                            <% } else { %>
                                                N/A
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                
                                <!-- Gender & Discount Column -->
                                <td class="px-6 py-4">
                                    <div class="space-y-1">
                                        <div class="text-sm text-gray-900">
                                            <span class="font-medium">Gender:</span>
                                            <span class="capitalize"><%= product.gender || 'N/A' %></span>
                                        </div>
                                        <% if (product.discount && product.discount > 0) { %>
                                            <div class="text-sm text-green-600 font-medium">
                                                <%= product.discount %>% OFF
                                            </div>
                                        <% } else { %>
                                            <div class="text-xs text-gray-500">No discount</div>
                                        <% } %>
                                    </div>
                                </td>
                                
                                <!-- Actions Column -->
                                <td class="px-6 py-4">
                                    <div class="space-y-2">
                                        <button 
                                            class="edit-product-btn w-50 bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs hover:bg-blue-200 transition-colors"
                                            data-product-id="<%= product._id %>">
                                            Edit
                                        </button>
                                        
                                        <button 
                                            class="delete-product-btn w-50 bg-red-100 text-red-700 px-2 py-1 rounded text-xs hover:bg-red-200 transition-colors"
                                            data-product-id="<%= product._id %>">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } else { %>
        <div class="text-center py-12">
            <div class="mx-auto h-12 w-12 text-gray-400">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
            </div>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No products found</h3>
            <p class="mt-1 text-sm text-gray-500">Products will appear here when you add them.</p>
        </div>
    <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Edit product functionality
    const editButtons = document.querySelectorAll('.edit-product-btn');
    editButtons.forEach(button => {
        button.addEventListener('click', function() {
            const productId = this.dataset.productId;
            alert(`Edit product ${productId} - This functionality can be implemented later`);
        });
    });
    
    // Delete product functionality
    const deleteButtons = document.querySelectorAll('.delete-product-btn');
    deleteButtons.forEach(button => {
        button.addEventListener('click', function() {
            const productId = this.dataset.productId;
            if (confirm('Are you sure you want to delete this product?')) {
                alert(`Delete product ${productId} - This functionality can be implemented later`);
            }
        });
    });
});
</script>
