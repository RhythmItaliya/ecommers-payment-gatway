<div class="p-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Manage Orders</h1>
        <p class="text-gray-600">View and update order statuses - Total Orders: <%= orders ? orders.length : 0 %></p>
    </div>
    
    <% if (orders && orders.length > 0) { %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">All Orders (<%= orders.length %>)</h3>
            </div>
            
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product Items</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% orders.forEach(order => { %>
                            <tr class="hover:bg-gray-50">
                                <!-- Order ID Column -->
                                <td class="px-6 py-4">
                                    <div class="text-sm font-medium text-gray-900">
                                        #<%= order._id.toString().slice(-8) %>
                                    </div>
                                    <% if (order.orderNumber) { %>
                                        <div class="text-xs text-blue-600 font-mono">
                                            <%= order.orderNumber %>
                                        </div>
                                    <% } %>
                                </td>

                                <!-- Email ID Column -->
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900">
                                        <%= order.userId?.email || 'N/A' %>
                                    </div>
                                </td>

                                <!-- Payment Status Column -->
                                <td class="px-6 py-4">
                                    <div class="space-y-1">
                                        <% if (order.paymentId) { %>
                                            <div class="text-xs text-green-600 font-medium">
                                                ✓ Paid
                                            </div>
                                        <% } else { %>
                                            <div class="text-xs text-red-600 font-medium">
                                                ✗ Unpaid
                                            </div>
                                        <% } %>
                                        <div class="text-xs text-gray-500">
                                            ₹<%= order.totalAmount || 0 %>
                                        </div>
                                        <div class="text-xs text-gray-500">
                                            <%= order.paymentMethod || 'N/A' %>
                                        </div>
                                    </div>
                                </td>

                                <!-- Product Items Column -->
                                <td class="px-6 py-4">
                                    <div class="space-y-1">
                                        <div class="text-xs text-gray-600">
                                            <% if (order.items && order.items.length > 0) { %>
                                                <% order.items.forEach((item, index) => { %>
                                                    <div class="flex justify-between items-center mb-1">
                                                        <span class="text-sm"><%= item.productId?.name || 'Product' %></span>
                                                        <span class="text-xs text-gray-500">x<%= item.quantity %></span>
                                                        <span class="text-xs text-blue-600">₹<%= item.price || 0 %></span>
                                                    </div>
                                                <% }); %>
                                            <% } else { %>
                                                <span class="text-gray-500">No products</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                
                                <!-- Actions Column -->
                                <td class="px-6 py-4">
                                    <div class="space-y-2">
                                        <select 
                                            class="order-status-select w-full border border-gray-300 rounded px-2 py-1 text-sm"
                                            data-order-id="<%= order._id %>"
                                            data-current-status="<%= order.status %>">
                                            <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                            <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>Processing</option>
                                            <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Shipped</option>
                                            <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                            <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                        </select>
                                        <div class="text-xs text-gray-500 mt-1 current-status">
                                            <%= order.status || 'pending' %>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } else { %>
        <div class="text-center py-12">
            <div class="mx-auto h-12 w-12 text-gray-400">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
            </div>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No orders found</h3>
            <p class="mt-1 text-sm text-gray-500">Orders will appear here when customers place them.</p>
        </div>
    <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const statusSelects = document.querySelectorAll('.order-status-select');
    
    statusSelects.forEach(select => {
        select.addEventListener('change', async function() {
            const orderId = this.dataset.orderId;
            const newStatus = this.value;
            const currentStatus = this.dataset.currentStatus;
            
            if (newStatus === currentStatus) return;
            
            try {
                const response = await fetch(`/api/orders/${orderId}/status`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ status: newStatus })
                });
                
                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        // Update the current status
                        this.dataset.currentStatus = newStatus;
                        
                        // Update the status badge
                        const statusTextEl = this.closest('tr').querySelector('.current-status');
                        if (statusTextEl) {
                            statusTextEl.textContent = newStatus;
                        }
                        
                        // Show success message
                        alert(`Order status updated to ${newStatus}`);
                    }
                } else {
                    throw new Error('Failed to update status');
                }
            } catch (error) {
                alert('Failed to update order status. Please try again.');
                // Reset to previous status
                this.value = currentStatus;
            }
        });
    });
});
</script>
